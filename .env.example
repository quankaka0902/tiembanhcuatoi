APP_NAME="Tiệm Bánh Nhà Mình"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:18842
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiembanh_dev
DB_USERNAME=tiembanh
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@tiembanh.test"
MAIL_FROM_NAME="${APP_NAME}"

BAKERY_DEMO_SEED=false
BAKERY_REHEARSAL=false
BAKERY_TRUSTED_PROXIES=

BAKERY_MONITOR_ENABLED=false
BAKERY_OPS_ROOT=
BAKERY_MONITOR_CA=
BAKERY_MONITOR_WEB_USER=
BAKERY_MONITOR_WEB_PASSWORD=
BAKERY_ALERT_URL=
BAKERY_ALERT_TOKEN=
BAKERY_BACKUP_ENABLED=false
BAKERY_BACKUP_TIME=03:00
BAKERY_BACKUP_MAX_AGE_HOURS=26
BAKERY_BACKUP_ROOT=
BAKERY_BACKUP_COPY_ROOT=
BAKERY_BACKUP_MYSQL_DEFAULTS=
BAKERY_MYSQLDUMP=mysqldump
